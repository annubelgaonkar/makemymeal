# Postgres connection string. Vercel sets this automatically when you add a Neon (Vercel Postgres) database.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Long random string used to encrypt OTPs and sign kitchen logins. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Password the chef types to open the kitchen screen.
KITCHEN_PASSWORD=change-me

# Optional: SMS (leave SMS empty until your MSG91 DLT template is approved)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
